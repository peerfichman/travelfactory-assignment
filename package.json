{
  "name": "travelfactory-assignment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"packages/**/*.{ts,vue,json,yaml}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,vue,json,yaml}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.2",
    "vue-eslint-parser": "^10.4.1"
  },
  "lint-staged": {
    "packages/**/*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/*.{json,yaml,md}": [
      "prettier --write"
    ]
  }
}
