{
  "name": "@travelfactory/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node src/index.ts --local",
    "build": "cef-build",
    "codegen": "cef-gen-handlers",
    "migrate": "typeorm-ts-node-commonjs migration:run -d src/infrastructure/database.ts",
    "migrate:generate": "typeorm-ts-node-commonjs migration:generate -d src/infrastructure/database.ts",
    "migrate:revert": "typeorm-ts-node-commonjs migration:revert -d src/infrastructure/database.ts",
    "seed": "ts-node seeds/seed.ts",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.ts",
    "test:all": "jest && jest --config jest.integration.config.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "commoneventframework": "^1.0.19",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "pino-pretty": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
